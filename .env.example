GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
WORKERS=2
USE_CACHE=0
# Gmail (see ARCHITECTURE.md 5.5)
GMAIL_QUERY=label:helpdesk
GMAIL_MAX=50
# SECRETS_DIR=C:/path/outside/onedrive   (optional; default ./secrets)

# --- Deployed backend only (leave unset locally: no login, SQLite in ./.data) ---
# DB_PATH=/tmp/helpdesk.db
# LOGS_DIR=/tmp/helpdesk-logs
# DEMO_PASSWORD=          # set it to require a login (POST /api/login -> signed token)
# AUTH_SECRET=            # signs the login token (falls back to DEMO_PASSWORD)
# ADMIN_KEY=              # needed for Gmail fetch/drafts when DEMO_PASSWORD is set
# DAILY_LLM_CAP=300       # LLM calls per day for the public demo (0 = no cap)
# CORS_ORIGINS=https://your-app.vercel.app
# GMAIL_TOKEN_JSON=       # contents of secrets/token.json (generate locally, Testing-mode token lasts 7 days)
